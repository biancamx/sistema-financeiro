{
  "name": "financeiro-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API do sistema de gestão financeira (Express + MongoDB)",
  "main": "src/server.js",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node scripts/seed.js",
    "backup": "node scripts/backup.js",
    "restore:backup": "node scripts/restore-backup.js",
    "migrate:security": "node scripts/migrate-security.js",
    "generate:vapid": "web-push generate-vapid-keys",
    "test": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.3.0",
    "express-rate-limit": "^7.4.1",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.11.2",
    "multer": "^2.4.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^11.3.0",
    "web-push": "^4.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.4.3"
  }
}
