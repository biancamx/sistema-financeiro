# Copie para .env e preencha antes de executar: docker compose up --build
# Gere JWT_SECRET com `openssl rand -hex 32`.
# Codifique os caracteres especiais da senha dentro da MONGODB_URI.

# Obrigatórias para o deploy
# Exemplo URI Atlas: mongodb+srv://USUARIO:SENHA@cluster.mongodb.net/caderno?retryWrites=true&w=majority
MONGODB_URI=
JWT_SECRET=
# Gere com `openssl rand -hex 32`; não reutilize JWT_SECRET.
AI_KEY_SECRET=

# URL exata do frontend, sem barra no final
FRONTEND_URL=http://localhost:8080

# Autenticação
ENABLE_LOCAL_LOGIN=false
# Este endereço será promovido a administrador e liberado automaticamente.
ADMIN_EMAIL=
ALLOWED_DOMAINS=gmail.com
GOOGLE_CLIENT_ID=
JWT_EXPIRES_IN=7d
# Para sites diferentes, use "none" somente com HTTPS.
COOKIE_SAMESITE=lax

# Limites e logs
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=40
LOG_LEVEL=info

# Deixe vazio se frontend e API forem servidos no mesmo domínio.
VITE_API_URL=
