# ── Servidor ──────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173

# ── Banco de dados (SQLite, arquivo local) ────────────────
DB_PATH=./data/financeiro.db

# ── Auth ──────────────────────────────────────────────────
# Em produção é OBRIGATÓRIO trocar (use: openssl rand -hex 32)
JWT_SECRET=troque-isto-em-producao
# Login "modo local" (1 clique, com dados de exemplo). Desligue em produção.
ENABLE_LOCAL_LOGIN=true
# Google (DESATIVADO enquanto estiver vazio)
GOOGLE_CLIENT_ID=
# Se front e back ficarem em domínios diferentes em produção: none (exige HTTPS)
COOKIE_SAMESITE=lax

# ── Rate limit ────────────────────────────────────────────
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=40

# ── Logs ──────────────────────────────────────────────────
LOG_LEVEL=info
