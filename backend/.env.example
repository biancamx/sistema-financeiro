NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/database?retryWrites=true&w=majority
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
JWT_SECRET=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_FORTE
# Gere uma chave independente com `openssl rand -hex 32`.
AI_KEY_SECRET=SUBSTITUA_POR_64_CARACTERES_HEXADECIMAIS
# Gere e guarde em local seguro; usado para criptografar e restaurar backups.
BACKUP_ENCRYPTION_KEY=SUBSTITUA_POR_64_CARACTERES_HEXADECIMAIS
JWT_EXPIRES_IN=7d
ENABLE_LOCAL_LOGIN=true
# A conta administradora deve comprovar este endereço pelo Google OAuth.
ADMIN_EMAIL=
ALLOWED_DOMAINS=gmail.com
GOOGLE_CLIENT_ID=
COOKIE_SAMESITE=lax
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=40
# Gere o par com `npm run generate:vapid` e mantenha-o estável após assinar dispositivos.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Token exclusivo; em produção use pelo menos 32 bytes aleatórios e diferencie do JWT_SECRET.
JOBS_TOKEN=
LOG_LEVEL=info
